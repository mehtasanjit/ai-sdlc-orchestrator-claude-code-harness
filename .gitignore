# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Build output for the bundled MCP server
plugin/mcp/model-dispatch/dist/

# Antigravity agent worker's Python environment. Built on demand by
# verify-setup.mjs --enable-agent; machine-specific (a virtualenv hardcodes the
# interpreter's absolute path), so a committed one would be broken elsewhere.
# Its source and requirements.txt ARE tracked.
plugin/mcp/model-dispatch/worker/.venv/
__pycache__/

# Ephemeral scratch left by subagents mid-run; never part of the release.
plugin/mcp/model-dispatch/_run*/
plugin/mcp/model-dispatch/*.mjs

# Raw model responses a subagent might dump at the repo root during debugging.
_raw_*.txt
_raw_*.json

# Run outputs. /mmo:greenfield writes to ./src and ./.sdlc in whatever directory
# it was started from; /mmo:pass writes under examples/<study-id>/passes/.
/src/
/.sdlc/
examples/*/passes/*/

# Exceptions: the two published runs of the quick-demo brief, one down each
# Gemini door. Shipped evidence, not someone's leftover run.
!examples/quick-demo/passes/model-path/
!examples/quick-demo/passes/agent-path/
examples/quick-demo/passes/*/src/node_modules/

# Generated MCP registration — per-machine, absolute paths + copied API keys.
.mcp.json

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Hook heartbeat log written by plugin/hooks/telemetry.sh
.hook-logs/

# Claude Code project state (project-installed commands + agents).
# Ignore contents (not the directory itself) so the exception below can
# re-include the maintainer-only skills subtree for contributors. Skills
# under .claude/ are not shipped in the mmo plugin — the marketplace
# source is ./plugin only.
.claude/*
!.claude/skills/

# A temporary compile made by tools/test/server-bundle.test.mjs (removed after the test)
plugin/mcp/model-dispatch/.bundle-check-*/
